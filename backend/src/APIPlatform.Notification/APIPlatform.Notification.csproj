<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Grants the test project whitebox access to internal SQL-generation types (NotificationSqlBuilder,
         dialects, row-mapping types) so their exact output can be asserted without a live database.
         These types stay internal because they are implementation detail, not public contract. -->
    <InternalsVisibleTo Include="APIPlatform.Notification.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Notification depends only on platform abstractions, per architecture rules: Foundation
         (IClock, Result/OperationResult/PagedResult) and Database (IDatabaseExecutor). No
         reference to CrudEngine, SignalR/Realtime, CrossCutting, or any application project. -->
    <ProjectReference Include="..\APIPlatform.Foundation\APIPlatform.Foundation.csproj" />
    <ProjectReference Include="..\APIPlatform.Database\APIPlatform.Data.csproj" />
  </ItemGroup>
</Project>
