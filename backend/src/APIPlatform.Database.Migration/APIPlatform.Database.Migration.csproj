<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Grants the test project whitebox access to internal SQL-generation types
         (MigrationHistorySqlBuilder, dialects) so their exact output can be asserted without a
         live database — same convention APIPlatform.Notification uses for the same reason. -->
    <InternalsVisibleTo Include="APIPlatform.Database.Migration.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- This package deploys/versions database schema ONLY. It depends solely on platform
         abstractions: Foundation (IClock, ErrorInfo/exceptions) and Database (IDatabaseExecutor,
         IDatabaseTransaction, DatabaseOptions). No reference to APIPlatform.Notification,
         CrudEngine, SignalR/Realtime, CrossCutting, or any application project — the package
         must never see Notification's (or any module's) business types, only raw DDL text. -->
    <ProjectReference Include="..\APIPlatform.Foundation\APIPlatform.Foundation.csproj" />
    <ProjectReference Include="..\APIPlatform.Database\APIPlatform.Data.csproj" />
  </ItemGroup>
</Project>
